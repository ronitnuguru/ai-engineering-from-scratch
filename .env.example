# API Keys for AI Engineering from Scratch
# Copy this to .env and fill in your actual keys
# NEVER commit .env to git (it's already in .gitignore)

# Anthropic (Claude) - Required for Phases 11-16
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI - Optional, for comparison in Phase 11
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=sk-your-key-here

# Hugging Face - Optional, for model downloads in Phases 4-10
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-token-here

# Google AI (Gemini) - Optional
GOOGLE_API_KEY=your-key-here
